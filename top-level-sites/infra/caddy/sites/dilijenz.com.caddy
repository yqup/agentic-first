# Edge route for dilijenz.com.
# Generated by top-level-sites/build-sites.mjs. Review before applying on ANI.
# Normal pages are handled by the per-site container from an ingested Gamma snapshot.

dilijenz.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:8218 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {http.request.remote.host}
	}

	log {
		output file /var/log/caddy/dilijenz.com.access.log {
			roll_size 10mb
			roll_keep 14
		}
		format json
	}
}

www.dilijenz.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	redir https://dilijenz.com{uri} permanent

	log {
		output file /var/log/caddy/dilijenz.com.access.log {
			roll_size 10mb
			roll_keep 14
		}
		format json
	}
}
