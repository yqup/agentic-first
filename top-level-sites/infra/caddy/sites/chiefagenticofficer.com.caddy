# Edge route for chiefagenticofficer.com.
# Generated by top-level-sites/build-sites.mjs. Review before applying on ANI.
# Normal pages are served by the per-site English-country static container.

chiefagenticofficer.com, www.chiefagenticofficer.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy 127.0.0.1:8214 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {http.request.remote.host}
	}

	log {
		output file /var/log/caddy/chiefagenticofficer.com.access.log {
			roll_size 10mb
			roll_keep 14
		}
		format json
	}
}
