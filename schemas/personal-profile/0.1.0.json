{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directory.agentic-first.co/schemas/personal-profile-0.1.0.json",
  "title": "Personal Profile",
  "description": "Public personal profile for the agentic-first directory. For founders, NEDs, advisors, fractional executives, consultants, and anyone whose engagements are ad-hoc and discoverable. Public-tier metrics MUST avoid precise compensation, calendar links, and live engagement state — those go on the protected tier served from a private MCP. Past role *count* is banded; only material roles (max 5) appear by name with evidence URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "person"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer; bump major on breaking changes."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the publisher last regenerated this profile."
    },
    "locale": {
      "type": "string",
      "default": "en-GB"
    },
    "profile_kind": {
      "type": "string",
      "const": "person",
      "description": "Subject discriminator. Optional for backward compatibility; if present MUST be 'person'."
    },
    "tier": {
      "type": "string",
      "const": "public",
      "description": "Tier discriminator. Optional for backward compatibility; if present MUST be 'public'."
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "headline"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The name you publicly use professionally."
        },
        "preferred_name": { "type": "string" },
        "pronouns": { "type": "string", "maxLength": 30 },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "One-liner identity statement."
        },
        "website": { "type": "string", "format": "uri" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "city": { "type": "string" },
            "region": { "type": "string" },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "description": "ISO 3166-1 alpha-2."
            }
          }
        },
        "bio": { "type": "string", "maxLength": 2000 },
        "expertise": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 12,
          "description": "Hyphenated lowercase tags."
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "description": "ISO 639-1 codes (with optional region)."
        },
        "photo_url": { "type": "string", "format": "uri" }
      }
    },
    "current_roles": {
      "type": "array",
      "maxItems": 10,
      "description": "Currently held roles.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "organisation"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "organisation": { "type": "string", "minLength": 1 },
          "organisation_url": { "type": "string", "format": "uri" },
          "since": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2})?$",
            "description": "YYYY or YYYY-MM."
          },
          "evidence_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "past_roles_band": {
      "type": "string",
      "enum": ["0", "1-2", "3-4", "5+"],
      "description": "Banded count of past roles. Public-surface only — no full history on the public tier."
    },
    "key_past_roles": {
      "type": "array",
      "maxItems": 5,
      "description": "Material past roles only, with evidence URLs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "organisation"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "organisation": { "type": "string", "minLength": 1 },
          "organisation_url": { "type": "string", "format": "uri" },
          "from": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
          "to": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
          "evidence_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "credentials": {
      "type": "array",
      "maxItems": 10,
      "description": "Professional credentials. Verifiable IDs feed the trust score directly.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Body or qualification, e.g. 'ICAEW', 'CFA', 'IoD', 'PhD'."
          },
          "id": { "type": "string" },
          "evidence_url": { "type": "string", "format": "uri" },
          "issued": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Citations supporting public claims. Empty arrays cap the trust score.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "press", "podcast", "talk", "publication", "case-study",
              "registry", "credential", "other"
            ]
          },
          "url": { "type": "string", "format": "uri" },
          "captured_at": { "type": "string", "format": "date" },
          "supports": {
            "type": "string",
            "description": "JSON Pointer to the field this evidence backs, e.g. '/key_past_roles/0'."
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" },
      "description": "Keyed links e.g. linkedin, github, twitter, mastodon, website."
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_channel": {
          "type": "string",
          "enum": ["email", "form", "private-mcp", "none"]
        },
        "email": { "type": "string", "format": "email" },
        "form_url": { "type": "string", "format": "uri" },
        "private_mcp": {
          "type": "string",
          "format": "uri",
          "description": "Pointer to the protected-tier MCP, if you run one."
        },
        "notes": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
