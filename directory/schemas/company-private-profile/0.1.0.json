{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-first.co/directory/schemas/company-private-profile-0.1.0.json",
  "title": "Company Profile (private, token-gated)",
  "description": "Diligence-grade company information served from an adopter's PRIVATE MCP to authenticated principals. Mirrors the public company-profile but with precise figures, fundraise detail, and append-only updates. The agentic-first directory deliberately never crawls or indexes this; it lives wholly under adopter control. All sections are optional so adopters publish only what they're ready to share. Adopters' MCPs SHOULD enforce per-section scopes (financials:read, fundraise:read, traction:read, updates:read) and audit every read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "profile_kind": {
      "type": "string",
      "const": "company",
      "description": "Subject discriminator. Optional for backward compatibility; if present MUST be 'company'."
    },
    "tier": {
      "type": "string",
      "const": "protected",
      "description": "Tier discriminator. Optional for backward compatibility; if present MUST be 'protected'."
    },
    "financials": {
      "type": "object",
      "additionalProperties": false,
      "description": "Precise financial figures. Requires scope financials:read.",
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "as_of": { "type": "string", "format": "date" },
        "revenue": { "type": "number", "minimum": 0 },
        "arr": { "type": "number", "minimum": 0 },
        "mrr": { "type": "number", "minimum": 0 },
        "gross_margin_pct": { "type": "number", "minimum": -100, "maximum": 100 },
        "burn_per_month": { "type": "number" },
        "runway_months": { "type": "integer", "minimum": 0 },
        "cash_on_hand": { "type": "number", "minimum": 0 },
        "methodology": { "type": "string", "maxLength": 500 }
      }
    },
    "traction": {
      "type": "object",
      "additionalProperties": false,
      "description": "Customer-side traction. Requires scope traction:read.",
      "properties": {
        "customer_count": { "type": "integer", "minimum": 0 },
        "logos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "nda": { "type": "boolean", "description": "If true, do not display in marketing. Audit logs treat this as sensitive." }
            }
          }
        },
        "pipeline_band": {
          "type": "string",
          "enum": ["<100k", "100k-500k", "500k-1m", "1m-5m", "5m-25m", ">25m", "undisclosed"]
        },
        "churn_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "nps": { "type": "integer", "minimum": -100, "maximum": 100 },
        "as_of": { "type": "string", "format": "date" }
      }
    },
    "fundraise": {
      "type": "object",
      "additionalProperties": false,
      "description": "Active fundraise detail. Requires scope fundraise:read. Most sensitive section. Adopters in jurisdictions with financial-promotion rules (e.g. UK FCA) MUST keep this server gated and audited; making it accidentally anonymous would re-introduce the very risk that motivated the public/private split.",
      "properties": {
        "active": { "type": "boolean", "description": "False = informational only, not currently raising." },
        "instrument": { "type": "string", "enum": ["SAFE", "Equity", "Convertible", "ASA", "Note", "Other"] },
        "ask": { "type": "number", "minimum": 0 },
        "ask_band": {
          "type": "string",
          "enum": ["<100k", "100k-500k", "500k-1m", "1m-5m", "5m-25m", "25m-100m", ">100m"]
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "valuation_target": { "type": "number", "minimum": 0 },
        "room_left": { "type": "number", "minimum": 0 },
        "use_of_funds": { "type": "string", "maxLength": 1000 },
        "deck_url": { "type": "string", "format": "uri" },
        "data_room_url": { "type": "string", "format": "uri" },
        "syndicate": { "type": "array", "items": { "type": "string" } },
        "close_target_date": { "type": "string", "format": "date" }
      }
    },
    "updates": {
      "type": "array",
      "description": "Append-only updates visible to authenticated principals, newest first. Requires scope updates:read.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "body"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
