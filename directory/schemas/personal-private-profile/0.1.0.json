{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-first.co/directory/schemas/personal-private-profile-0.1.0.json",
  "title": "Personal Profile (private, token-gated)",
  "description": "Diligence-grade personal information served from a publisher's PRIVATE MCP to authenticated principals. Designed for the engagement-discovery use case: a recruiter, board chair, or portfolio CEO has been told about you, visits your public profile, requests access, and is then handed back the protected payload. The agentic-first directory deliberately never crawls or indexes this. All sections are optional so publishers serve only what they're ready to share. Publishers' MCPs SHOULD enforce per-section scopes (engagement:read, career:read, portfolio:read, contact:read, updates:read) and audit every read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "profile_kind": {
      "type": "string",
      "const": "person",
      "description": "Subject discriminator. Optional for backward compatibility; if present MUST be 'person'."
    },
    "tier": {
      "type": "string",
      "const": "protected",
      "description": "Tier discriminator. Optional for backward compatibility; if present MUST be 'protected'."
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "description": "Live engagement state. Requires scope engagement:read.",
      "properties": {
        "available": {
          "type": "boolean",
          "description": "False = informational only, not currently taking new engagements."
        },
        "type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "advisory", "fractional", "non-exec", "executive-search",
              "interim", "board-chair", "consulting", "contract", "permanent"
            ]
          },
          "description": "Kinds of engagement currently considered."
        },
        "day_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "$ref": "#/$defs/currency" }
          }
        },
        "annual_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "type": "number", "minimum": 0 },
            "currency": { "$ref": "#/$defs/currency" }
          }
        },
        "advisory_equity_pct_band": {
          "type": "string",
          "enum": ["<0.1%", "0.1-0.5%", "0.5-1.0%", "1.0-2.0%", ">2.0%", "case-by-case"]
        },
        "availability_hours_per_week": {
          "type": "number",
          "minimum": 0,
          "maximum": 168
        },
        "next_availability": { "type": "string", "format": "date" },
        "geographies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "description": "ISO 3166-1 alpha-2 codes; sectors/regions you'll work in."
        }
      }
    },
    "career": {
      "type": "object",
      "additionalProperties": false,
      "description": "Full career history. Requires scope career:read.",
      "properties": {
        "experience": {
          "type": "array",
          "description": "Full role history, newest first.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "organisation", "from"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "organisation": { "type": "string", "minLength": 1 },
              "organisation_url": { "type": "string", "format": "uri" },
              "from": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
              "to": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
              "scope": { "type": "string", "maxLength": 1000 },
              "outcomes": {
                "type": "array",
                "items": { "type": "string", "maxLength": 200 },
                "maxItems": 8
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "role": { "type": "string" },
                    "contact_via": {
                      "type": "string",
                      "enum": ["email", "form", "intro-required"]
                    }
                  }
                }
              }
            }
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["institution"],
            "properties": {
              "institution": { "type": "string" },
              "qualification": { "type": "string" },
              "field": { "type": "string" },
              "year": { "type": "string", "pattern": "^\\d{4}$" }
            }
          }
        }
      }
    },
    "portfolio": {
      "type": "array",
      "description": "Material engagements (titles, outcomes, NDA flag) — the protected counterpart to a public case-studies page. Requires scope portfolio:read.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "organisation": { "type": "string" },
          "outcomes": { "type": "string", "maxLength": 1000 },
          "from": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
          "to": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
          "nda": {
            "type": "boolean",
            "description": "If true, do not display in marketing. Audit logs treat this as sensitive."
          },
          "evidence_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "contact_private": {
      "type": "object",
      "additionalProperties": false,
      "description": "Private contact details — only visible after access is granted. Requires scope contact:read.",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "calendar_url": { "type": "string", "format": "uri" },
        "signal": { "type": "string" },
        "address": { "type": "string", "maxLength": 500 }
      }
    },
    "updates": {
      "type": "array",
      "description": "Append-only updates visible to authenticated principals, newest first. Requires scope updates:read.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "body"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code."
    }
  }
}
