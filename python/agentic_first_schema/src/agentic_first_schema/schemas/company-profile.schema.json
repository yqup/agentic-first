{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://directory.agentic-first.co/schemas/company-profile-0.1.0.json",
  "title": "Company Profile",
  "description": "Public company profile for the agentic-first directory. Public-surface metrics MUST use bands, not precise numbers, to keep the directory outside the scope of FCA financial-promotion rules. Evidence URLs are strongly encouraged on every material claim and feed the confidence score.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_at", "company"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "SemVer; bump major on breaking changes."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the publisher last regenerated this profile."
    },
    "locale": {
      "type": "string",
      "default": "en-GB"
    },
    "profile_kind": {
      "type": "string",
      "const": "company",
      "description": "Subject discriminator. Optional for backward compatibility; if present MUST be 'company'."
    },
    "tier": {
      "type": "string",
      "const": "public",
      "description": "Tier discriminator. Optional for backward compatibility; if present MUST be 'public'."
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "website", "jurisdiction"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Trading name."
        },
        "legal_name": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code where the company is registered."
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "description": "Statutory registry record. Verified registry IDs feed the trust score directly.",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["companies-house", "delaware", "secretary-of-state", "edgar", "other"]
            },
            "id": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "lei": {
          "type": "string",
          "pattern": "^[A-Z0-9]{20}$",
          "description": "GLEIF Legal Entity Identifier."
        },
        "founded": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2})?$",
          "description": "YYYY or YYYY-MM."
        },
        "industry": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 8,
          "description": "Free-text tags. Lower-cased and hyphenated by convention."
        },
        "tagline": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 2000 },
        "logo_url": { "type": "string", "format": "uri" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": {
          "type": "string",
          "enum": [
            "Pre-Seed", "Seed", "Series A", "Series B", "Series C",
            "Series D+", "Growth", "Profitable", "Public", "Acquired", "Closed"
          ]
        },
        "since": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" }
      }
    },
    "funding": {
      "type": "object",
      "additionalProperties": false,
      "description": "Public-surface funding data. Use bands; precise figures belong on the private MCP.",
      "properties": {
        "total_raised_band": { "$ref": "#/$defs/money_band" },
        "currency": { "$ref": "#/$defs/currency" },
        "last_round": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "date"],
          "properties": {
            "stage": { "type": "string" },
            "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
            "amount_band": { "$ref": "#/$defs/money_band" },
            "currency": { "$ref": "#/$defs/currency" },
            "lead_investor": { "type": "string" },
            "evidence_url": { "type": "string", "format": "uri" }
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "date"],
            "properties": {
              "stage": { "type": "string" },
              "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$" },
              "amount_band": { "$ref": "#/$defs/money_band" },
              "currency": { "$ref": "#/$defs/currency" },
              "lead_investor": { "type": "string" },
              "evidence_url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headcount_band": { "$ref": "#/$defs/headcount_band" },
        "key_people": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "linkedin": { "type": "string", "format": "uri" },
              "evidence_url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "Public metrics MUST be banded. No precise revenue, growth, or customer counts on the public surface.",
      "properties": {
        "revenue_band": { "$ref": "#/$defs/money_band" },
        "growth_band": { "$ref": "#/$defs/growth_band" },
        "customers_band": { "$ref": "#/$defs/count_band" },
        "as_of": { "type": "string", "format": "date" }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Citations supporting public claims. Empty arrays cap the trust score.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "filing", "press", "podcast", "case-study",
              "customer-list", "registry", "audit", "other"
            ]
          },
          "url": { "type": "string", "format": "uri" },
          "captured_at": { "type": "string", "format": "date" },
          "supports": { "type": "string", "description": "JSON Pointer to the field this evidence backs, e.g. '/funding/last_round/amount_band'." }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" },
      "description": "Keyed links e.g. linkedin, twitter, github, crunchbase."
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_channel": {
          "type": "string",
          "enum": ["email", "form", "private-mcp", "none"]
        },
        "email": { "type": "string", "format": "email" },
        "form_url": { "type": "string", "format": "uri" },
        "private_mcp": { "type": "string", "format": "uri" },
        "notes": { "type": "string", "maxLength": 500 }
      }
    }
  },
  "$defs": {
    "money_band": {
      "type": "string",
      "enum": [
        "<100k", "100k-500k", "500k-1m",
        "1m-5m", "5m-25m", "25m-100m",
        "100m-500m", ">500m", "undisclosed"
      ]
    },
    "growth_band": {
      "type": "string",
      "enum": [
        "negative", "flat", "0-20%", "20-50%",
        "50-100%", "100-300%", ">300%", "undisclosed"
      ]
    },
    "count_band": {
      "type": "string",
      "enum": [
        "<10", "10-100", "100-1k", "1k-10k",
        "10k-100k", "100k-1m", ">1m", "undisclosed"
      ]
    },
    "headcount_band": {
      "type": "string",
      "enum": [
        "1-10", "11-50", "51-200", "201-500",
        "501-1000", "1001-5000", ">5000"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 currency code."
    }
  }
}
